{
  "manifest_version": 3,
  "name": "arXiv to Markdown",
  "version": "1.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "SimonSun",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "notifications",
    "alarms",
    "contextMenus"
  ],
  "optional_permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://ar5iv.org/*",
    "https://ar5iv.labs.arxiv.org/*",
    "https://export.arxiv.org/*",
    "https://mineru.net/*",
    "https://cdn-mineru.openxlab.org.cn/*"
  ],
  "optional_host_permissions": [
    "https://paddleocr.aistudio-app.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://arxiv.org/pdf/*",
        "https://arxiv.org/html/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_title": "arXiv to Markdown"
  },
  "commands": {
    "convert-current-paper": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "__MSG_cmdConvertDescription__"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "https://arxiv.org/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "arxiv-md@tendo33"
    }
  }
}
