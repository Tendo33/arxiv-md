{
  "name": "arxiv-md",
  "version": "1.3.0",
  "description": "arXiv to Markdown — browser extension that saves arXiv papers as clean Markdown, with math, tables and references intact.",
  "author": "SimonSun",
  "license": "MIT",
  "homepage": "https://github.com/Tendo33/arxiv-md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tendo33/arxiv-md.git"
  },
  "bugs": {
    "url": "https://github.com/Tendo33/arxiv-md/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "build:firefox": "webpack --mode production --env target=firefox",
    "verify:dist": "node scripts/verify-dist.js",
    "verify:dist:chrome": "node scripts/verify-dist.js dist --target=chrome",
    "verify:dist:firefox": "node scripts/verify-dist.js dist-firefox --target=firefox",
    "dev": "webpack --mode development --watch",
    "lint": "eslint src/**/*.js \"packages/pdf-parse-core/src/**/*.js\"",
    "test": "jest --runInBand",
    "test:e2e": "npm run build && node scripts/e2e-shortcut.js && node scripts/e2e-popup-a11y.js && node scripts/e2e-popup-tasklist.js && node scripts/e2e-popup-width.js && node scripts/e2e-popup-dnr-note.js && node scripts/e2e-settings-provider-pick.js && node scripts/e2e-abs-buttons.js && node scripts/e2e-popup-addendum.js && node scripts/e2e-focus-red.js && node scripts/e2e-keepalive.js",
    "package": "npm run build && npm run build:firefox && npm run verify:dist:chrome && npm run verify:dist:firefox && node scripts/package.js",
    "check:keys": "node scripts/check-no-keys.js",
    "test:core-coverage": "jest --runInBand tests/pdf-core --coverage --collectCoverageFrom='packages/pdf-parse-core/src/**/*.js' --coverageThreshold='{\"global\":{\"lines\":85}}'"
  },
  "dependencies": {
    "linkedom": "^0.18.12",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.24.0",
    "archiver": "^7.0.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "katex": "^0.19.1",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [
    "arxiv",
    "markdown",
    "chrome-extension",
    "pdf",
    "converter",
    "academic",
    "papers"
  ]
}
